{
  "name": "my-first-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "deno serve --watch=. --allow-read --allow-env jsr:@mastrojs/mastro/server",
    "dev": "pnpm run generate && wrangler dev",
    "build": "pnpm run generate && wrangler build",
    "generate": "node node_modules/@mastrojs/mastro/src/generator.js --only-pregenerate --write-routenames",
    "deploy": "wrangler deploy",
    "check": "tsc",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=24.12"
  },
  "dependencies": {
    "@mastrojs/mastro": "npm:@jsr/mastrojs__mastro@^0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
